{%- comment -%}
  Product add-ons — a product-page row of add-on products, built to look and
  behave exactly like the "featured collection" and "related products" rows
  on the same page: the same heading, the same product cards
  (snippets/card-product.liquid, with GoKwik Buy Now and ratings) and the
  same carousel. The list carries the `pdp-featured-collection` class, which
  assets/main.js turns into that Owl carousel (6 / 4 / 3 / 2 across).

  WHERE THE PRODUCTS COME FROM (first one that has products wins; each
  source can be switched off with the "Product list" setting)
  1. "Pick products here": a product list chosen in the theme editor on this
     section. Same add-ons on every product page.
  2. This product's own list: a product metafield, key set in "Product
     metafield" (default custom.add_on_products). Create it at Settings >
     Custom data > Products > Add definition, type Product > List of
     products, and fill it on each product.
  3. The shared list: the first active entry of the metaobject type set in
     "Metaobject type" (default cart_add_ons — the cart drawer's "Cart
     add-ons", see snippets/cart-addons.liquid); its product list field must
     have the key `products`.

  The product being viewed and sold-out products are skipped. With nothing
  to show, the section renders nothing (the theme editor shows a hint).
{%- endcomment -%}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .product-addons slider-component ul {
    padding: 0;
    list-style: none;
  }
{%- endstyle -%}

{%- liquid
  assign addon_source = section.settings.source
  assign addon_products = blank

  # 1. Picked in the theme editor.
  if addon_source == 'auto' or addon_source == 'picked'
    if section.settings.products != blank
      assign addon_products = section.settings.products
    endif
  endif

  # 2. This product's metafield, e.g. "custom.add_on_products".
  if addon_products == blank
    if addon_source == 'auto' or addon_source == 'product'
      assign mf_key = section.settings.metafield_key | default: 'custom.add_on_products' | strip
      assign mf_parts = mf_key | split: '.'
      if mf_parts.size == 2
        assign mf_namespace = mf_parts | first
        assign mf_name = mf_parts | last
        assign own_products = product.metafields[mf_namespace][mf_name].value
        if own_products != blank
          assign addon_products = own_products
        endif
      endif
    endif
  endif

  # 3. The shared metaobject list, e.g. type "cart_add_ons", field "products".
  if addon_products == blank
    if addon_source == 'auto' or addon_source == 'shared'
      assign mo_type = section.settings.metaobject_type | default: 'cart_add_ons' | strip
      assign shared_entry = metaobjects[mo_type].values | first
      if shared_entry != blank
        assign addon_products = shared_entry.products.value
      endif
    endif
  endif

  assign addon_count = 0
  for p in addon_products
    if p.id != product.id and p.available
      assign addon_count = addon_count | plus: 1
    endif
  endfor
-%}

{%- if addon_count > 0 -%}
  <div class="product-addons color-{{ section.settings.color_scheme }} isolate gradient">
    <div class="section-{{ section.id }}-padding collection--full-width" id="product-addons-{{ section.id }}" data-id="{{ section.id }}">
      {%- if section.settings.title != blank -%}
        <div class="collection__title title-wrapper title-wrapper--no-top-margin page-width collection__title--desktop-slider">
          <h2 class="section-heading inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        </div>
      {%- endif -%}

      <slider-component class="page-width slider-mobile-gutter slider-component-full-width slider-component-desktop">
        <ul
          id="Slider-{{ section.id }}"
          data-id="{{ section.id }}"
          class="pdp-featured-collection owl-carousel owl-theme"
          aria-label="{{ 'general.slider.name' | t }}"
        >
          {%- assign skip_card_product_styles = false -%}
          {%- assign shown = 0 -%}
          {%- for addon in addon_products -%}
            {%- liquid
              if shown >= section.settings.products_to_show
                break
              endif
              if addon.id == product.id or addon.available == false
                continue
              endif
              assign shown = shown | plus: 1
            -%}
            <li id="Slide-{{ section.id }}-{{ shown }}" class="item">
              {% render 'card-product',
                card_product: addon,
                media_aspect_ratio: section.settings.image_ratio,
                image_shape: 'default',
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: false,
                show_rating: section.settings.show_rating,
                skip_styles: skip_card_product_styles,
                section_id: section.id,
                quick_add: 'none'
              %}
            </li>
            {%- assign skip_card_product_styles = true -%}
          {%- endfor -%}
        </ul>
      </slider-component>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width section-{{ section.id }}-padding">
    <p class="caption">
      Product add-ons: nothing to show for this product. Pick products in this section's settings, fill
      this product's "{{ section.settings.metafield_key | default: 'custom.add_on_products' | escape }}" metafield,
      or add products to the first entry of the "{{ section.settings.metaobject_type | default: 'cart_add_ons' | escape }}"
      metaobject.
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product add-ons",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Add-ons for this product",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Product list",
      "options": [
        { "value": "auto", "label": "First available: picked, product metafield, metaobject" },
        { "value": "picked", "label": "Only products picked below" },
        { "value": "product", "label": "Only the product metafield" },
        { "value": "shared", "label": "Only the metaobject list" }
      ],
      "default": "auto",
      "info": "\"First available\" uses the products picked below if any; otherwise this product's metafield; otherwise the metaobject list."
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Pick products here",
      "limit": 24,
      "info": "Optional. Shown on every product page. Leave empty to use the metafield or metaobject below."
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Product metafield",
      "default": "custom.add_on_products",
      "info": "namespace.key of a product metafield of type \"Product > List of products\" (Settings > Custom data > Products). Lets each product have its own add-ons."
    },
    {
      "type": "text",
      "id": "metaobject_type",
      "label": "Metaobject type",
      "default": "cart_add_ons",
      "info": "Type of the metaobject holding the shared list; its first active entry is used, from a product list field with the key \"products\". cart_add_ons is the cart drawer's \"Cart add-ons\"."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 12,
      "label": "Maximum products to show"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "t:sections.featured-collection.settings.image_ratio.options__1.label" },
        { "value": "portrait", "label": "t:sections.featured-collection.settings.image_ratio.options__2.label" },
        { "value": "square", "label": "t:sections.featured-collection.settings.image_ratio.options__3.label" }
      ],
      "default": "adapt",
      "label": "t:sections.featured-collection.settings.image_ratio.label"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.featured-collection.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": true,
      "label": "t:sections.featured-collection.settings.show_rating.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Product add-ons"
    }
  ]
}
{% endschema %}
