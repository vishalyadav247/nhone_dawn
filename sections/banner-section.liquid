<section class="color-{{ section.settings.color_scheme }} {% if section.settings.secondary_background %}background-secondary{% else %}gradient{% endif %}">
  {% assign imagesSelected = false %}
  <div class="bannerCarousel owl-carousel">
    {% for block in section.blocks %}
      {% if block.settings.image_desktop != blank or block.settings.image_mobile != blank %}
        {% assign imagesSelected = true %}
        <div class="carousel-item">
          <a
            href="{{ block.settings.image_url | default: '#' }}"
            {% if block.settings.open_in_new_tab %}
              target="_blank"
            {% endif %}
          >
            {%- liquid
              assign img_desktop = block.settings.image_desktop | default: block.settings.image_mobile
              assign img_mobile = block.settings.image_mobile | default: block.settings.image_desktop
              # Slide 1 is the LCP element: load it immediately at high
              # priority. Later slides are off-screen until Owl rotates them.
              if forloop.first
                assign img_loading = 'eager'
                assign img_priority = 'high'
              else
                assign img_loading = 'lazy'
                assign img_priority = 'auto'
              endif
            -%}
            <picture>
              <source
                media="(max-width: 749px)"
                srcset="
                  {{ img_mobile | image_url: width: 375 }} 375w,
                  {{ img_mobile | image_url: width: 550 }} 550w,
                  {{ img_mobile | image_url: width: 750 }} 750w,
                  {{ img_mobile | image_url: width: 1100 }} 1100w,
                  {{ img_mobile | image_url: width: 1500 }} 1500w
                "
                sizes="100vw"
                width="{{ img_mobile.width }}"
                height="{{ img_mobile.height }}"
              >
              <img
                srcset="
                  {{ img_desktop | image_url: width: 1100 }} 1100w,
                  {{ img_desktop | image_url: width: 1500 }} 1500w,
                  {{ img_desktop | image_url: width: 1920 }} 1920w,
                  {{ img_desktop | image_url: width: 2560 }} 2560w
                "
                src="{{ img_desktop | image_url: width: 1920 }}"
                sizes="100vw"
                alt="{{ block.settings.image_alt | escape }}"
                width="{{ img_desktop.width }}"
                height="{{ img_desktop.height }}"
                loading="{{ img_loading }}"
                fetchpriority="{{ img_priority }}"
                {% unless forloop.first %}decoding="async"{% endunless %}
              >
            </picture>
          </a>
        </div>
      {% endif %}
    {% endfor %}
    {% if imagesSelected == false %}
      <p>Please upload desktop and mobile images and add URLs in the block settings.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Banner Carousel",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Banner image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Alt Text",
          "default": "Image description"
        },
        {
          "type": "url",
          "id": "image_url",
          "label": "Link URL",
          "default": "/"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner Carousel",
      "category": "Custom"
    }
  ]
}
{% endschema %}
