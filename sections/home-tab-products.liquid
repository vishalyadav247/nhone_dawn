{%- comment -%}
  Not added to templates. sections/home-page-tabbber.liquid fetches this
  through the Section Rendering API on a collection URL
  (/collections/<handle>?section_id=home-tab-products) to load a tab's
  products when the tab is opened. `collection` is that URL's collection.
{%- endcomment -%}
{%- assign tab_section_id = 'home-tab-' | append: collection.id -%}
{%- render 'home-tab-products', collection: collection, section_id: tab_section_id -%}

{% schema %}
{
  "name": "Home tab products",
  "settings": []
}
{% endschema %}
