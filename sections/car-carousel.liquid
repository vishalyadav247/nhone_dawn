{%- comment -%}
  Car carousel — an auto-scrolling row of linked image cards (Owl Carousel,
  initialised in assets/main.js).

  Used twice on the home page: "Shop by Category" (product photos) and
  "Shop by Brand" (logos). The "Card style" setting tunes the card for each:
  - image: the photo fills a soft gradient well.
  - logo:  logos on a white card with a thin border, always in full colour.

  The prev/next arrows render into .nh-slider-nav beside the heading
  (Owl's navContainer option), not over the slides.

  Styles live in assets/style.css under "Car carousel".
{%- endcomment -%}

<section
  class="car-carousel-section car-carousel--{{ section.settings.card_style | default: 'image' }} page-width color-{{ section.settings.color_scheme }} {% if section.settings.secondary_background %}background-secondary{% else %}gradient{% endif %}"
>
  <div class="car-carousel__header">
    {% render 'section-heading', heading: section.settings['section-heading'] %}
    <div class="nh-slider-nav"></div>
  </div>

  {% assign textFound = false %}
  <div class="CarCarousel owl-carousel" data-rtl="{{ section.settings.reverse_direction }}">
    {% for block in section.blocks %}
      {% if block.settings.Car_text != blank %}
        {% assign textFound = true %}
        <div class="carousel-item" {{ block.shopify_attributes }}>
          <a
            href="{{ block.settings.link_url | default: '#' }}"
            class="carousel-link"
            {% if block.settings.open_in_new_tab %}
              target="_blank" rel="noopener"
            {% endif %}
          >
            <figure class="carousel-figure">
              <span class="carousel-media">
                {%- if block.settings.image_desktop -%}
                  {{
                    block.settings.image_desktop
                    | image_url: width: 400
                    | image_tag:
                      widths: '160, 240, 320, 400',
                      sizes: '(min-width: 1200px) 140px, (min-width: 750px) 180px, 30vw',
                      loading: 'lazy',
                      alt: block.settings.image_alt,
                      class: 'carousel-img'
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'carousel-img carousel-img--placeholder' }}
                {%- endif -%}
              </span>
              <figcaption class="carousel-caption">
                {{ block.settings.Car_text }}
              </figcaption>
            </figure>
          </a>
        </div>
      {% endif %}
    {% endfor %}
    {% if textFound == false %}
      <p>Please add Car text in block settings.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Car Carousel",
  "settings": [
    {
      "type": "text",
      "id": "section-heading",
      "label": "Section Heading",
      "info": "Put a pipe before the words you want in the brand colour, e.g. \"SHOP BY |CATEGORY\". The pipe itself is not shown."
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "image", "label": "Product images" },
        { "value": "logo", "label": "Brand logos" }
      ],
      "default": "image"
    },
    {
      "type": "checkbox",
      "id": "reverse_direction",
      "label": "Reverse Scroll Direction",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "secondary_background",
      "label": "Use Secondary Background",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "Text Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Alt Text",
          "default": "Image description"
        },
        {
          "type": "text",
          "id": "Car_text",
          "label": "Car Caption Text",
          "default": "Your Car Name here"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL",
          "default": "/"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Car Carousel",
      "category": "Custom"
    }
  ]
}
{% endschema %}
