{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<style>
  #shopify-tabber-{{ section.id }} {

    .owl-stage-outer{
      padding-bottom:2px;
    }
  
    .tab-nav {
      list-style: none;
      padding: 0;
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-top: 0 !important;
      color:var(--nh-heading);

      span.tab-nav{
        gap: 10px;
      }

      li {
        padding: 8px 16px;
        border: 1px solid var(--nh-brand);
        cursor: pointer;
        border-radius: 4rem;
        transition: 0.3s;

        &.active {
          background-color: var(--nh-brand);
          color: #fff;
          border-color: var(--nh-brand);
        }
      }
    }
    .tab-pane {
      display: none;

      &.active {
        display: block;
        margin-top: 20px;
      }
    }

    .item {
      text-align: center;

      img {
        max-width: 100%;
        height: auto;
      }
    }

  }
</style>

<section class="shopify-tabber" id="shopify-tabber-{{ section.id }}">
  <div class="page-width">
    <!-- Tab Navigation -->
    <ul class="tab-nav">
      {% if section.settings.title != blank %}
        {% render 'section-heading', heading: section.settings.title %}
      {% endif %}
      <span class="tab-nav">
        {% for block in section.blocks %}
          {% assign collection = block.settings.collection %}
          <li class="{% if forloop.first %}active{% endif %}" data-tab="tab-{{ section.id }}-{{ block.id }}">
            {{ collection.title }}
          </li>
        {% endfor %}
      </span>
    </ul>

    <!-- Tab Content -->
    {%- comment -%}
      Only the first tab's cards are live DOM on page load. The other tabs are
      wrapped in <template>, which the browser parses but never lays out,
      fetches images for, or exposes to scripts — this keeps ~100 product
      cards out of the initial render. The script below moves a template's
      cards into the page the first time its tab is clicked.
    {%- endcomment -%}
    <div class="tab-content">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}

        <div
          id="tab-{{ section.id }}-{{ block.id }}"
          class="tab-pane {% if forloop.first %}active{% endif %}"
        >
          {%- unless forloop.first -%}<template class="tab-pane__deferred">{%- endunless -%}
          {% if collection.products_count > 0 %}
            <div class="product-carousel owl-carousel carousel">
              {% assign available_count = 0 %}

              {% for product in collection.products %}
                {% if product.available %}
                  <div class="item">
                    {% render 'card-product',
                      card_product: product,
                      media_aspect_ratio: 'adapt',
                      image_shape: 'default',
                      show_secondary_image: true,
                      show_vendor: false,
                      show_rating: true,
                      quick_add: 'standard',
                      section_id: section.id
                    %}
                  </div>

                  {% assign available_count = available_count | plus: 1 %}
                  {% if available_count == 15 %}
                    {% break %}
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>
          {% else %}
            <p>No products found in this collection.</p>
          {% endif %}
          {%- unless forloop.first -%}</template>{%- endunless -%}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
<script>
  (function () {
    // Scoped to this section: the script is emitted once per tabber, so it
    // must not also initialise the other tabbers on the page.
    var section = document.getElementById('shopify-tabber-{{ section.id }}');
    if (!section) return;

    var NAV_ARROW_LEFT =
      '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12H4"></path><path d="M10 6l-6 6 6 6"></path></svg>';
    var NAV_ARROW_RIGHT =
      '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"></path><path d="M14 6l6 6-6 6"></path></svg>';

    // Move a deferred tab's cards out of its <template> into the page.
    function hydrate(pane) {
      var tpl = pane.querySelector('template.tab-pane__deferred');
      if (!tpl) return;
      pane.replaceChild(tpl.content, tpl);

      // Snapmint adds its EMI line to product cards in a single pass when it
      // loads, so cards added later need another pass. collectionList() is
      // Snapmint's global and skips cards it has already decorated.
      if (typeof window.collectionList === 'function') {
        try {
          window.collectionList('.product-card-wrapper');
        } catch (e) {}
      }
    }

    function initCarousel(pane) {
      if (!pane || typeof window.jQuery !== 'function') return;
      var $carousel = window.jQuery(pane).find('.product-carousel');
      if (!$carousel.length || $carousel.hasClass('owl-loaded')) return;

      $carousel.owlCarousel({
        margin: 10,
        loop: false,
        nav: true,
        dots: false,
        navText: [NAV_ARROW_LEFT, NAV_ARROW_RIGHT],
        responsive: {
          0: { items: 2, margin: 5, nav: false },
          600: { items: 2 },
          1000: { items: 6 },
        },
      });
    }

    function init() {
      var tabLinks = section.querySelectorAll('.tab-nav li');
      var tabPanes = section.querySelectorAll('.tab-pane');

      initCarousel(section.querySelector('.tab-pane.active'));

      tabLinks.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var target = section.querySelector('#' + tab.getAttribute('data-tab'));
          if (!target || target.classList.contains('active')) return;

          tabLinks.forEach(function (el) { el.classList.remove('active'); });
          tabPanes.forEach(function (el) { el.classList.remove('active'); });
          tab.classList.add('active');

          hydrate(target);
          target.classList.add('active');
          // Owl measures its container, so wait until the pane is displayed.
          requestAnimationFrame(function () { initCarousel(target); });
        });
      });
    }

    // jQuery + Owl load with defer, so they are ready by DOMContentLoaded.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

{% schema %}
{
  "name": "Tabber Section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "info": "Put a pipe before the words you want in the brand colour, e.g. \"FEATURED |PRODUCTS\". The pipe itself is not shown.",
      "default": "Browse By |Category"
    }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "Collection Tab",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabber Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
