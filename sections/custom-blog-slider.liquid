{%- comment -%}
  Custom blog slider: latest articles from one blog in an Owl Carousel.

  Header row: heading (+ optional intro text) on the left; on the right a
  "View all" link and the prev/next arrows. The arrows reuse the split-capsule
  buttons shared with every slider (.nh-slider-nav in style.css) via Owl's
  navContainer option.

  Cards: compact framed cards with a square cover, date + reading time and
  the title. 4 per view on desktop, 3 on tablets, 2 on phones.

  Styles live in assets/style.css under "Blog slider".
{%- endcomment -%}

{%- liquid
  assign blog = blogs[section.settings.blog.handle]
  assign view_all_url = section.settings.view_all_url
  if view_all_url == blank and blog
    assign view_all_url = blog.url
  endif
-%}

<div class="blog-slider-wrapper">
  <div class="page-width">
    <div class="blog-header">
      <div class="blog-header__text">
        {% render 'section-heading', heading: section.settings.heading %}
        {%- if section.settings.content != blank -%}
          <div class="blog-desc">{{ section.settings.content }}</div>
        {%- endif -%}
      </div>

      <div class="blog-header__actions">
        {%- if section.settings.view_all_label != blank and view_all_url != blank -%}
          <a href="{{ view_all_url }}" class="blog-view-all">
            {{- section.settings.view_all_label | escape -}}
          </a>
        {%- endif -%}
        <div class="nh-slider-nav blog-slider__nav"></div>
      </div>
    </div>

    <div class="owl-carousel blog-slider">
      {%- if blog -%}
        {%- for article in blog.articles limit: section.settings.article_limit -%}
          {%- comment -%}
            'item blog-slide' are Owl's own hooks — the card itself lives in
            snippets/nh-blog-card.liquid and is shared with the blog hub, the
            category page and the article page's related row.
          {%- endcomment -%}
          {% render 'nh-blog-card', article: article, extra_classes: 'item blog-slide' %}
        {%- endfor -%}
      {%- else -%}
        <p>No blog selected or blog does not exist.</p>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    $('.blog-slider').each(function () {
      var $carousel = $(this);
      var $nav = $carousel.closest('.blog-slider-wrapper').find('.blog-slider__nav');

      $carousel.owlCarousel({
        loop: false,
        margin: 15,
        nav: true,
        dots: false,
        navContainer: $nav.length ? $nav : false,
        navText: [
          '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4"></path><path d="M10 6l-6 6 6 6"></path></svg>',
          '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16"></path><path d="M14 6l6 6-6 6"></path></svg>'
        ],
        responsive: {
          0: {
            items: 2,
            margin: 12,
            nav: true,
            dots: true
          },
          750: {
            items: 3,
            margin: 15
          },
          1100: {
            items: 4,
            margin: 15
          }
        }
      });

      $nav.find('.owl-prev').attr('aria-label', 'Previous articles');
      $nav.find('.owl-next').attr('aria-label', 'Next articles');

      // Owl measures slide widths at init; re-measure once fonts and images
      // have loaded, in case the layout shifted.
      $(window).on('load', function () {
        $carousel.trigger('refresh.owl.carousel');
      });
    });
  });
</script>

{% schema %}
{
  "name": "Custom Blog Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "info": "Put a pipe before the words you want in the brand colour, e.g. \"LATEST FROM |OUR BLOGS\". The pipe itself is not shown."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Section Content"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog"
    },
    {
      "type": "number",
      "id": "article_limit",
      "label": "Number of Articles",
      "default": 6
    },
    {
      "type": "header",
      "content": "View all link"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Link text",
      "default": "View all",
      "info": "Leave empty to hide the link."
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "Link",
      "info": "Leave empty to link to the selected blog."
    }
  ],
  "presets": [
    {
      "name": "Custom Blog Slider"
    }
  ]
}
{% endschema %}
