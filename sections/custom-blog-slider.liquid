{%- comment -%}
  Custom blog slider: the most recent articles from every blog, newest first,
  in an Owl Carousel. Not tied to one category — the articles are gathered
  across all blogs and sorted by publish date, so the row is always the
  store's latest writing whichever category it came from.

  Header row: heading (+ optional intro text) on the left; on the right a
  "View all" link and the prev/next arrows. The arrows reuse the split-capsule
  buttons shared with every slider (.nh-slider-nav in style.css) via Owl's
  navContainer option.

  Cards: compact framed cards with a square cover, date + reading time and
  the title. 4 per view on desktop, 3 on tablets, 2 on phones.

  Styles live in assets/style.css under "Blog slider".
{%- endcomment -%}

{%- liquid
  # The newest articles across every blog the merchant lists as a block.
  # Liquid's blogs object is a lookup drop, not an iterable one, so the
  # blogs have to be named — hence the blocks. Their articles are
  # concatenated (Liquid cannot merge arrays in place) and sorted once.
  assign recent_articles = '' | split: ''
  for block in section.blocks
    assign source_blog = block.settings.blog
    if source_blog != blank
      assign recent_articles = recent_articles | concat: source_blog.articles
    endif
  endfor
  assign recent_articles = recent_articles | sort: 'published_at' | reverse

  # "View all" goes to the blog hub, since the row is no longer one category.
  # Theme settings > Blog > Blog hub page; the section can override it.
  assign view_all_url = section.settings.view_all_url | default: settings.blog_hub_url
-%}

<div class="blog-slider-wrapper">
  <div class="page-width">
    <div class="blog-header">
      <div class="blog-header__text">
        {% render 'section-heading', heading: section.settings.heading %}
        {%- if section.settings.content != blank -%}
          <div class="blog-desc">{{ section.settings.content }}</div>
        {%- endif -%}
      </div>

      <div class="blog-header__actions">
        {%- if section.settings.view_all_label != blank and view_all_url != blank -%}
          <a href="{{ view_all_url }}" class="blog-view-all">
            {{- section.settings.view_all_label | escape -}}
          </a>
        {%- endif -%}
        <div class="nh-slider-nav blog-slider__nav"></div>
      </div>
    </div>

    <div class="owl-carousel blog-slider">
      {%- for article in recent_articles limit: section.settings.article_limit -%}
        {%- comment -%}
          'item blog-slide' are Owl's own hooks — the card itself lives in
          snippets/nh-blog-card.liquid and is shared with the blog hub, the
          category page and the article page's related row. The category pill
          is on because the row now mixes articles from several blogs.
        {%- endcomment -%}
        {%- comment -%}
          An article does not carry a reference to its blog, and the merged
          list has lost which block it came from, so the parent blog is looked
          up from the article URL: /blogs/<blog-handle>/<article-handle>.
        {%- endcomment -%}
        {%- assign article_blog_handle = article.url | split: '/blogs/' | last | split: '/' | first -%}
        {% render 'nh-blog-card',
          article: article,
          blog: blogs[article_blog_handle],
          show_category: section.settings.show_category,
          extra_classes: 'item blog-slide'
        %}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    $('.blog-slider').each(function () {
      var $carousel = $(this);
      var $nav = $carousel.closest('.blog-slider-wrapper').find('.blog-slider__nav');

      // Built after page load, once near the screen (nhWhenVisible in
      // assets/main.js); style.css lays the row out statically until then.
      var build = function () {
      $carousel.owlCarousel({
        loop: false,
        margin: 10,
        nav: true,
        dots: false,
        navContainer: $nav.length ? $nav : false,
        navText: [
          '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4"></path><path d="M10 6l-6 6 6 6"></path></svg>',
          '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16"></path><path d="M14 6l6 6-6 6"></path></svg>'
        ],
        responsive: {
          0: {
            items: 2,
            margin: 5,
            nav: true,
            dots: true
          },
          750: {
            items: 3,
            margin: 10
          },
          1100: {
            items: 4,
            margin: 10
          }
        }
      });

      $nav.find('.owl-prev').attr('aria-label', 'Previous articles');
      $nav.find('.owl-next').attr('aria-label', 'Next articles');
      };

      if (typeof window.nhWhenVisible === 'function') window.nhWhenVisible(this, build);
      else build();
    });
  });
</script>

{% schema %}
{
  "name": "Custom Blog Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "info": "Put a pipe before the words you want in the brand colour, e.g. \"LATEST FROM |OUR BLOGS\". The pipe itself is not shown."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Section Content"
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "default": true,
      "label": "Show category on each card",
      "info": "The row mixes articles from every blog, so the pill says which one each came from."
    },
    {
      "type": "number",
      "id": "article_limit",
      "label": "Number of Articles",
      "default": 6
    },
    {
      "type": "header",
      "content": "View all link"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Link text",
      "default": "View all",
      "info": "Leave empty to hide the link."
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "Link",
      "info": "Leave empty to use the blog hub page set in Theme settings > Blog."
    }
  ],
  "blocks": [
    {
      "type": "blog",
      "name": "Blog",
      "limit": 10,
      "settings": [
        {
          "type": "blog",
          "id": "blog",
          "label": "Blog",
          "info": "Articles from every blog listed here are merged and shown newest first. Create a new blog? Add a block for it here, or its posts will never appear in this row."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Blog Slider"
    }
  ]
}
{% endschema %}
