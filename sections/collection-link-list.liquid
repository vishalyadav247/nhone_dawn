{%- comment -%}
  Collection link list: the SEO link block at the bottom of the home page.

  A compact row of pill links to popular collections, under a small heading.
  On desktop the whole list shows (it wraps to a few rows). On phones, where
  the same list runs many rows deep, it is clipped to "Rows shown on mobile"
  with a Show all toggle — a checkbox drives it, so there is no JavaScript.

  Styles live in assets/style.css under "Collection link list".
{%- endcomment -%}

<section class="collection-link-list page-width" style="--nh-ll-rows: {{ section.settings.mobile_rows }};">
  {%- if section.settings.section_heading != blank -%}
    {% render 'section-heading', heading: section.settings.section_heading %}
  {%- endif -%}

  <input
    type="checkbox"
    id="CollectionLinks-{{ section.id }}"
    class="collection-link-list__toggle"
  >

  <ul class="collection-link-list__links list-unstyled" role="list">
    {%- for block in section.blocks -%}
      {%- if block.settings.collection != blank -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ block.settings.collection.url }}" class="collection-link-list__item">
            {{- block.settings.collection.title -}}
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>

  <label for="CollectionLinks-{{ section.id }}" class="collection-link-list__more">
    <span class="collection-link-list__more-show">{{ section.settings.show_all_label | escape }}</span>
    <span class="collection-link-list__more-hide">{{ section.settings.show_less_label | escape }}</span>
  </label>
</section>

{% schema %}
{
  "name": "Collection Link List",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Popular Car |Accessories List",
      "info": "Put a pipe before the words you want in the brand colour, e.g. \"POPULAR CAR |ACCESSORIES LIST\". The pipe itself is not shown."
    },
    {
      "type": "range",
      "id": "mobile_rows",
      "label": "Rows shown on mobile",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 3,
      "info": "The rest stay behind a Show all tap. Desktop always shows every link."
    },
    {
      "type": "text",
      "id": "show_all_label",
      "label": "Show all link text",
      "default": "Show all"
    },
    {
      "type": "text",
      "id": "show_less_label",
      "label": "Show less link text",
      "default": "Show less"
    }
  ],
  "blocks": [
    {
      "type": "collection_link",
      "name": "Collection Link",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Link List",
      "blocks": [
        {
          "type": "collection_link"
        }
      ]
    }
  ]
}
{% endschema %}
