<section class="feature-box-section">
  <div class="page-width">
    <div class="grid grid--2-col-only">
      {% for block in section.blocks %}
        <div class="feature-box">
          <a href="{{ block.settings.link | default: '#' }}" class="feature-box-inner">
            <div class="feature-box-image">
              {% if block.settings.image %}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.image_alt | escape }}"
                  loading="lazy"
                  height="auto"
                  width="auto"
                >
              {% else %}
                <p>No image available</p>
              {% endif %}
            </div>
            {% if block.settings.button_text != blank %}
              <div class="feature-box-content">
                <span class="feature-button">{{ block.settings.button_text }}</span>
              </div>
            {% endif %}
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .feature-box-section {
    margin: 20px 0;
  }

  .feature-box-section .grid {
    display: grid;
    gap: 20px;
  }

  .grid--2-col-only {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 749px) {
    .grid--2-col-only {
      grid-template-columns: 1fr;
    }
  }

  .feature-box {
    position: relative;
  }

  .feature-box-inner {
    display: block;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
    transition: box-shadow 0.3s;
  }

  .feature-box-inner:hover {
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  }

  .feature-box-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .feature-box-content {
    position: absolute;
    top: 30px;
    left: 30px;
    z-index: 2;
  }

  .feature-button {
    display: inline-block;
    background-color: #c62828;
    color: #fff;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
    border-radius: 4px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .feature-text {
    margin-top: 110px;
    padding: 10px;
    color: #222;
    font-size: 16px;
    font-weight: 500;
  }

  @media (max-width: 749px) {
    .feature-text {
      font-size: 14px;
      margin-top: 90px;
    }
  }
</style>
{% schema %}
{
  "name": "Shopping Guide Section",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Box",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Alt Text",
          "default": "Feature Image"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Click Here"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shopping Guide Section",
      "category": "Custom",
      "blocks": [{ "type": "feature" }, { "type": "feature" }]
    }
  ]
}
{% endschema %}
