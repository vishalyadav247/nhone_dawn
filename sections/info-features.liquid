      "label": "Description",
      "default": "10 Days Return Policy"
    },
    {
      "type": "image_picker",
      "id": "feature2_icon",
      "label": "Icon",
      "info": "Single-colour icon on a transparent background. It is shown in the brand colour."
    },

    {
      "type": "header",
      "content": "Feature 3"
    },
    {
      "type": "text",
      "id": "feature3_title",
      "label": "Title",
      "default": "COMFORT PAYMENTS"
    },
    {
      "type": "textarea",
      "id": "feature3_description",
      "label": "Description",
      "default": "COD and Online Payment Options"
    },
    {
      "type": "image_picker",
