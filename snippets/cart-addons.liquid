{%- comment -%}
  Cart add-ons: a small, sideways-scrolling row of products inside the cart
  drawer, under the cart items, each with a one-tap Add.

  WHERE THE PRODUCTS COME FROM
  A metaobject, so the list is edited in Shopify admin, not in code:
    Settings > Custom data > Metaobjects > "Cart add-ons"
      type:   cart_add_ons
      fields: heading  (Single line text)        e.g. "Add to your order"
              products (Product, list of products)
  The theme uses the FIRST ACTIVE entry of that type
  (Content > Metaobjects > Cart add-ons). With no definition, no entry or no
  products, nothing renders.

  CARD TITLE
  The drawer is narrow, so each card shows its "Add-on title", not the full
  product title. It comes from the product metafield custom.addon_title
  (Single line text, Settings > Custom data > Products), and falls back to
  the product title when that is empty. Screen readers and the hover tooltip
  still get the full title.

  WHAT IS SHOWN
  - Products already in the cart, and sold-out products, are skipped.
  - At most 12 cards.
  - Every card has an "Add" button that adds in place
    (assets/cart-addons.js). No option picker: the card always adds, and
    prices, the product's first available variant.

  Re-rendering: the drawer replaces its whole .drawer__inner after every
  cart change (cart-drawer.js / cart.js), so this row is rebuilt each time
  and an added product drops out of it on its own.

  Styles: assets/component-cart-addons.css. Both it and cart-addons.js load
  from layout/theme.liquid with the drawer: a <script> inside this snippet
  would not run when the drawer is re-rendered via innerHTML.
{%- endcomment -%}

{%- liquid
  assign addon_entry = metaobjects.cart_add_ons.values | first
  assign addon_products = blank
  if addon_entry != blank
    assign addon_products = addon_entry.products.value
  endif

  # Product ids already in the cart, as ",id," so a lookup can't match part
  # of a longer id.
  assign in_cart_ids = ','
  for item in cart.items
    assign in_cart_ids = in_cart_ids | append: item.product_id | append: ','
  endfor

  assign addon_heading = 'Add to your order'
  if addon_entry.heading.value != blank
    assign addon_heading = addon_entry.heading.value
  endif
  assign addon_shown = 0
-%}

{%- capture addon_cards -%}
  {%- for product in addon_products -%}
    {%- liquid
      if addon_shown >= 12
        break
      endif
      unless product.available
        continue
      endunless
      assign product_key = ',' | append: product.id | append: ','
      if in_cart_ids contains product_key
        continue
      endif
      assign addon_shown = addon_shown | plus: 1
      assign variant = product.first_available_variant
      assign addon_title = product.metafields.custom.addon_title.value | default: product.title | strip
    -%}
    <li class="cart-addon">
      <a href="{{ product.url }}" class="cart-addon__media" tabindex="-1" aria-hidden="true">
        {%- if product.featured_image -%}
          <img
            srcset="
              {{ product.featured_image | image_url: width: 80 }} 80w,
              {{ product.featured_image | image_url: width: 160 }} 160w,
              {{ product.featured_image | image_url: width: 240 }} 240w
            "
            sizes="44px"
            src="{{ product.featured_image | image_url: width: 160 }}"
            alt=""
            width="44"
            height="44"
            loading="lazy"
          >
        {%- endif -%}
      </a>
      <a href="{{ product.url }}" class="cart-addon__title" title="{{ product.title | escape }}">
        {{- addon_title | escape -}}
      </a>
      <div class="cart-addon__price">
        <span data-addon-price>{{ variant.price | money }}</span>
        <s data-addon-compare{% unless variant.compare_at_price > variant.price %} hidden{% endunless %}>
          {{- variant.compare_at_price | money -}}
        </s>
      </div>
      <div class="cart-addon__actions">
      <button
        type="button"
        class="cart-addon__add"
        data-addon-variant="{{ variant.id }}"
        aria-label="Add {{ product.title | escape }} to cart"
      >
        <span class="cart-addon__add-label">Add</span>
        <span class="cart-addon__spinner" aria-hidden="true"></span>
      </button>
      </div>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- if addon_shown > 0 -%}
  <cart-addons class="cart-addons">
    <div class="cart-addons__head">
      <h3 class="cart-addons__heading">{{ addon_heading | escape }}</h3>
      {%- comment -%}
        Previous / next for mouse and trackpad users (touch screens swipe, so
        CSS hides these there). cart-addons.js scrolls the row by one card
        and disables a button at its end; both hide when everything fits.
      {%- endcomment -%}
      <div class="cart-addons__nav" hidden>
        <button type="button" class="cart-addons__arrow" data-addon-scroll="-1" aria-label="Previous add-ons">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
        <button type="button" class="cart-addons__arrow" data-addon-scroll="1" aria-label="Next add-ons">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>
    <ul class="cart-addons__track list-unstyled" role="list">
      {{- addon_cards -}}
    </ul>
    <p class="cart-addons__error" role="alert" hidden></p>
  </cart-addons>
{%- endif -%}
