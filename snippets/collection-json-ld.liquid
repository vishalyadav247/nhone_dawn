{% comment %}
  Renders the CollectionPage JSON-LD structured data for collection pages:
  a CollectionPage node whose mainEntity is an ItemList of the products on
  the CURRENT page (summary-page pattern: name + url per item, full Product
  data lives on each product page), plus a BreadcrumbList (Home > Collection).

  Must be rendered INSIDE the {% paginate collection.products %} block so
  collection.products is limited to the current page and paginate is available
  for absolute item positions.

  Accepts:
  - collection: {Object} Collection Liquid object
  - paginate: {Object} paginate object from the enclosing paginate block

  Usage:
  {% render 'collection-json-ld', collection: collection, paginate: paginate %}
{% endcomment %}

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "CollectionPage",
    "@id": "{{ request.origin }}{{ collection.url }}#collection",
    "name": {{ collection.title | json }},
    "url": "{{ request.origin }}{{ collection.url }}{% if paginate.current_page > 1 %}?page={{ paginate.current_page }}{% endif %}",
    {%- if collection.description != blank %}
      "description": {{ collection.description | strip_html | json }},
    {%- endif %}
    {%- if collection.image %}
      "image": {{ collection.image | image_url: width: 1920 | prepend: 'https:' | json }},
    {%- endif %}
    "isPartOf": {
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | json }}
    },
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": {{ collection.products_count | json }},
      "itemListElement": [
        {%- for product in collection.products -%}
          {
            "@type": "ListItem",
            "position": {{ paginate.current_offset | plus: forloop.index }},
            "name": {{ product.title | json }},
            "url": "{{ request.origin }}{{ product.url }}"
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  }
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "{{ request.origin }}{{ routes.root_url }}"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": "{{ request.origin }}{{ collection.url }}"
      }
    ]
  }
</script>
