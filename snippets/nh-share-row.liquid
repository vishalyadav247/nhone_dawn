{%- comment -%}
  Share row: explicit network buttons plus Dawn's share-button component, which
  already handles the native share sheet and copy-to-clipboard.

  canonical_url is used rather than request.origin | append: article.url so the
  shared link survives ?variant=/utm noise and locale prefixes.

  WhatsApp leads the order — it is the dominant share channel for this store's
  market. Its icon is inline because the only WhatsApp asset in the theme is a
  third-party hosted image, which has no business on this page.

  Accepts:
  - article
  - block: {Object} the 'share' block

  Usage:
  {% render 'nh-share-row', article: article, block: block %}
{%- endcomment -%}

{%- liquid
  assign share_url = canonical_url
  if share_url == blank
    assign share_url = request.origin | append: article.url
  endif
  assign u = share_url | url_encode
  assign t = article.title | strip_html | url_encode
  # image_url returns a PROTOCOL-RELATIVE CDN url ("//cdn.shopify.com/..."), so
  # prepending request.origin would make it a path on the shop domain and the
  # Pin would 404. It just needs a scheme.
  assign share_img_raw = article.image | image_url: width: 1200
  if share_img_raw contains '://'
    assign share_img = share_img_raw | url_encode
  else
    assign share_img = share_img_raw | prepend: 'https:' | url_encode
  endif
-%}

<div
  class="nh-share article-template__social-sharing page-width page-width--narrow{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.share_label != blank -%}
    <span class="nh-share__label">{{ block.settings.share_label | escape }}</span>
  {%- endif -%}

  <ul class="nh-share__list list-unstyled">
    {%- if block.settings.show_whatsapp -%}
      <li>
        <a
          class="nh-share__btn nh-share__btn--whatsapp"
          href="https://wa.me/?text={{ t }}%20{{ u }}"
          target="_blank"
          rel="noopener noreferrer nofollow"
          aria-label="Share on WhatsApp"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="18" height="18">
            <path fill="currentColor" d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 0 1 8.24 8.24c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.86.84-.86 2.05s.88 2.38 1 2.54c.12.17 1.73 2.64 4.19 3.7.59.25 1.04.4 1.4.52.59.19 1.12.16 1.55.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"/>
          </svg>
        </a>
      </li>
    {%- endif -%}

    {%- if block.settings.show_facebook -%}
      <li>
        <a
          class="nh-share__btn"
          href="https://www.facebook.com/sharer/sharer.php?u={{ u }}"
          target="_blank"
          rel="noopener noreferrer nofollow"
          aria-label="Share on Facebook"
        >
          {{- 'icon-facebook.svg' | inline_asset_content -}}
        </a>
      </li>
    {%- endif -%}

    {%- if block.settings.show_x -%}
      <li>
        <a
          class="nh-share__btn"
          href="https://twitter.com/intent/tweet?url={{ u }}&amp;text={{ t }}"
          target="_blank"
          rel="noopener noreferrer nofollow"
          aria-label="Share on X"
        >
          {{- 'icon-twitter.svg' | inline_asset_content -}}
        </a>
      </li>
    {%- endif -%}

    {%- if block.settings.show_pinterest and article.image != blank -%}
      <li>
        <a
          class="nh-share__btn"
          href="https://pinterest.com/pin/create/button/?url={{ u }}&amp;media={{ share_img }}&amp;description={{ t }}"
          target="_blank"
          rel="noopener noreferrer nofollow"
          aria-label="Share on Pinterest"
        >
          {{- 'icon-pinterest.svg' | inline_asset_content -}}
        </a>
      </li>
    {%- endif -%}
  </ul>

  {%- if block.settings.show_copy -%}
    {% render 'share-button', block: block, share_link: share_url %}
  {%- endif -%}
</div>
