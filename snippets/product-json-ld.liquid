{% comment %}
  Renders the Product JSON-LD structured data script.

  Accepts:
  - product: {Object} Product Liquid object

  Usage:
  {% render 'product-json-ld', product: product %}
{% endcomment %}

{%- liquid
  assign price_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'
  assign rating_value = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  assign show_rating = false
  if rating_value and rating_count
    if rating_count > 0
      assign show_rating = true
    endif
  endif
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "@id": "{{ request.origin }}{{ product.url }}#product",
    "name": {{ product.title | json }},
    "url": "{{ request.origin }}{{ product.url }}",
    "image": [
      {%- for product_image in product.images -%}
        {{ product_image | image_url: width: 1920 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    "description": {{ product.description | strip_html | json }},
    {%- if product.selected_or_first_available_variant.sku != blank %}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif %}
    {%- if product.type != blank %}
      "category": {{ product.type | json }},
    {%- endif %}
    {%- if show_rating %}
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ rating_value.rating | json }},
        "bestRating": {{ rating_value.scale_max | json }},
        "ratingCount": {{ rating_count | json }}
      },
    {%- endif %}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "url": "{{ request.origin }}{{ variant.url }}",
          {%- if variant.sku != blank %}
            "sku": {{ variant.sku | json }},
          {%- endif %}
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceValidUntil": "{{ price_valid_until }}",
          "itemCondition": "https://schema.org/NewCondition",
          "availability": "{%- if variant.available -%}https://schema.org/InStock{%- else -%}https://schema.org/OutOfStock{%- endif -%}",
          "seller": {
            "@type": "Organization",
            "name": {{ shop.name | json }}
          }
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
</script>
