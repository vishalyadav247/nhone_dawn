{% comment %}
  Renders the "Pincode fitment checker" product block.

  Accepts:
  - block: {Object} the pincode_checker block (settings + shopify_attributes)
  - section_id: {String} the parent section id

  Usage:
  {% render 'pincode-checker', block: block, section_id: section.id %}
{% endcomment %}

{{ 'component-pincode-checker.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pincode-checker.js' | asset_url }}" defer="defer"></script>

<pincode-checker
  class="pincode-checker quick-add-hidden"
  data-section-id="{{ section_id }}"
  data-modal="#PincodeFitmentModal-{{ section_id }}"
  data-success-text="{{ block.settings.success_text }}"
  data-not-found-text="{{ block.settings.not_found_text }}"
  data-dialog-title="{{ block.settings.dialog_title | strip_html }}" 
  {{ block.shopify_attributes }}
>
  {%- liquid
    # Centres come from the "fitment_centre" metaobject, managed by the
    # merchant in admin: Settings > Custom data > Metaobjects. This is the
    # only data source — no entries means the checker stays idle.
    assign mo_centres = shop.metaobjects['fitment_centre'].values
  -%}
  {%- if mo_centres.size > 0 -%}
    <script type="application/json" data-fitment-centres>
      {
        "centres": [
          {%- for centre in mo_centres -%}
            {
              "name": {{ centre.name.value | json }},
              "address": {{ centre.address.value | json }},
              "phone": {{ centre.phone.value | json }},
              "maps": {{ centre.maps_url.value | json }},
              "pincodes": {{ centre.pincodes.value | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
  <div class="pincode-checker__card">
    <div class="pincode-checker__body">
      {%- if block.settings.heading != blank -%}
        <div class="pincode-checker__heading">{{ block.settings.heading }}</div>
      {%- endif -%}
      {%- if block.settings.subtext != blank -%}
        <div class="pincode-checker__subtext">{{ block.settings.subtext }}</div>
      {%- endif -%}
      <div class="pincode-checker__line">
        <div class="pincode-checker__row pincode-checker__row--input">
          <div class="pincode-checker__group">
            <span class="pincode-checker__group-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                focusable="false"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </span>
            <input
              class="pincode-checker__input"
              type="text"
              inputmode="numeric"
              autocomplete="postal-code"
              pattern="[0-9]{6}"
              maxlength="6"
              placeholder="Pincode"
              aria-label="Delivery pincode"
              id="PincodeInput-{{ section_id }}"
            >
            <button type="button" class="pincode-checker__button button button--secondary" aria-label="Check">
              <span class="pincode-checker__button-label">Check</span>
              <span class="pincode-checker__button-icon pincode-checker__button-icon--check" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  focusable="false"
                >
                  <circle cx="11" cy="11" r="7"/>
                  <path d="m21 21-4.3-4.3"/>
                </svg>
              </span>
              <span class="pincode-checker__button-icon pincode-checker__button-icon--change" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  focusable="false"
                >
                  <path d="M17 3a2.8 2.8 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                </svg>
              </span>
              <div class="loading__spinner hidden">
                {{- 'loading-spinner.svg' | inline_asset_content -}}
              </div>
            </button>
          </div>
        </div>
        <div class="pincode-checker__result" role="status" aria-live="polite" data-result>
          {%- if block.settings.idle_text != blank -%}
            <div class="pincode-checker__idle">{{ block.settings.idle_text }}</div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
  <modal-dialog id="PincodeFitmentModal-{{ section_id }}" class="pincode-fitment-modal">
    <div
      role="dialog"
      aria-modal="true"
      aria-labelledby="PincodeFitmentModalTitle-{{ section_id }}"
      class="pincode-fitment-modal__content"
      tabindex="-1"
    >
      <div class="pincode-fitment-modal__header">
        <h2 class="h4" id="PincodeFitmentModalTitle-{{ section_id }}" data-modal-title></h2>
        <button
          id="ModalClose-pincode-{{ section_id }}"
          type="button"
          class="pincode-fitment-modal__close"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
      </div>
      <div class="pincode-fitment-modal__list" data-centres-list></div>
    </div>
  </modal-dialog>
</pincode-checker>
