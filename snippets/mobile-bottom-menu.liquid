{%- comment -%}
  Mobile bottom tab bar. Rendered site-wide from layout/theme.liquid.

  Styles live in assets/style.css — search for "Mobile bottom tab bar". They
  used to sit in an inline <style> here, which shipped the same CSS on every
  page view and put it out of reach of the rest of the theme's tokens.

  Two contracts other files depend on, so don't rename them:
  - the cart link keeps `id="cart-icon-bubble"` and the badge keeps
    `.cart-count-bubble` — assets/main.js looks them up (scoped to
    `.mobile-bottom-menu`) to refresh the count after an AJAX cart change;
  - the last link keeps `id="mobileBottomMenuTrackOrder"` —
    snippets/track-order-popup.liquid binds the popup to it.

  Icons are all solid glyphs on a 512-high viewBox so they share one optical
  weight, and they carry no `fill` attribute: the CSS paints them with
  `currentColor`, which is what makes the active state recolour.
{%- endcomment -%}

{%- liquid
  assign bm_home_active = false
  assign bm_account_active = false
  assign bm_cart_active = false

  if template.name == 'index'
    assign bm_home_active = true
  endif
  if template.name contains 'customers'
    assign bm_account_active = true
  endif
  if template.name == 'cart'
    assign bm_cart_active = true
  endif
-%}

<nav class="mobile-bottom-menu" aria-label="Quick links">
  <a
    href="{{ routes.root_url }}"
    class="mobile-bottom-menu__item{% if bm_home_active %} is-active{% endif %}"
    {% if bm_home_active %}aria-current="page"{% endif %}
  >
    <span class="mobile-bottom-menu__icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" aria-hidden="true" focusable="false">
        <path d="M240 6.1c9.1-8.2 22.9-8.2 32 0l232 208c9.9 8.8 10.7 24 1.8 33.9s-24 10.7-33.9 1.8l-8-7.2 0 205.3c0 35.3-28.7 64-64 64l-288 0c-35.3 0-64-28.7-64-64l0-205.3-8 7.2c-9.9 8.8-25 8-33.9-1.8s-8-25 1.8-33.9L240 6.1zm16 50.1L96 199.7 96 448c0 8.8 7.2 16 16 16l48 0 0-104c0-39.8 32.2-72 72-72l48 0c39.8 0 72 32.2 72 72l0 104 48 0c8.8 0 16-7.2 16-16l0-248.3-160-143.4zM208 464l96 0 0-104c0-13.3-10.7-24-24-24l-48 0c-13.3 0-24 10.7-24 24l0 104z"/>
      </svg>
    </span>
    <span class="mobile-bottom-menu__label">Home</span>
  </a>

  <a
    href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
    class="mobile-bottom-menu__item{% if bm_account_active %} is-active{% endif %}"
    rel="nofollow"
    {% if bm_account_active %}aria-current="page"{% endif %}
  >
    <span class="mobile-bottom-menu__icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" aria-hidden="true" focusable="false">
        <path d="M144 128a80 80 0 1 1 160 0 80 80 0 1 1 -160 0zm208 0a128 128 0 1 0 -256 0 128 128 0 1 0 256 0zM48 480c0-70.7 57.3-128 128-128l96 0c70.7 0 128 57.3 128 128l0 8c0 13.3 10.7 24 24 24s24-10.7 24-24l0-8c0-97.2-78.8-176-176-176l-96 0C78.8 304 0 382.8 0 480l0 8c0 13.3 10.7 24 24 24s24-10.7 24-24l0-8z"/>
      </svg>
    </span>
    <span class="mobile-bottom-menu__label">Account</span>
  </a>

  <a
    href="{{ routes.cart_url }}"
    class="mobile-bottom-menu__item{% if bm_cart_active %} is-active{% endif %}"
    id="cart-icon-bubble"
    onclick="event.preventDefault(); document.querySelector('.header__icon--cart').click();"
    {% if bm_cart_active %}aria-current="page"{% endif %}
  >
    <span class="mobile-bottom-menu__icon">
      <svg class="icon--line" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
        <path d="M3 6h18"/>
        <path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
    </span>
    <span class="mobile-bottom-menu__label">Basket</span>
    <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
    {%- if cart != empty -%}
      <div class="cart-count-bubble">
        {%- if cart.item_count < 100 -%}
          <span aria-hidden="true">{{ cart.item_count }}</span>
        {%- endif -%}
        <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
      </div>
    {%- endif -%}
  </a>

  <a
    class="mobile-bottom-menu__item mobile-whatsapp-widget"
    href="https://wa.me/919996775500?text=Hello!%20I%20have%20a%20question%20about%20your%20store"
    target="_blank"
    rel="noopener"
  >
    <span class="mobile-bottom-menu__icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" aria-hidden="true" focusable="false">
        <path d="M380.9 97.1c-41.9-42-97.7-65.1-157-65.1-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480 117.7 449.1c32.4 17.7 68.9 27 106.1 27l.1 0c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3 18.6-68.1-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1s56.2 81.2 56.1 130.5c0 101.8-84.9 184.6-186.6 184.6zM325.1 300.5c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8s-14.3 18-17.6 21.8c-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7s-12.5-30.1-17.1-41.2c-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2s-9.7 1.4-14.8 6.9c-5.1 5.6-19.4 19-19.4 46.3s19.9 53.7 22.6 57.4c2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4s4.6-24.1 3.2-26.4c-1.3-2.5-5-3.9-10.5-6.6z"/>
      </svg>
    </span>
    <span class="mobile-bottom-menu__label">Contact</span>
  </a>

  <a
    aria-label="Track Order"
    class="mobile-bottom-menu__item mobile-track-order-link"
    href="#"
    id="mobileBottomMenuTrackOrder"
  >
    <span class="mobile-bottom-menu__icon">
      <svg class="icon--line" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/>
        <path d="M15 18H9"/>
        <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/>
        <circle cx="17" cy="18" r="2"/>
        <circle cx="7" cy="18" r="2"/>
      </svg>
    </span>
    <span class="mobile-bottom-menu__label">Track Order</span>
  </a>
</nav>
