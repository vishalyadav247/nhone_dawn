    "content_section_NJcANL": {
      "type": "content-section",
      "disabled": true,
      "settings": {
        "heading": "ABOUT US",
        "paragraph": "<p>At NH ONE, we’re driven by a passion for performance, innovation, and style on the road. As a trusted brand in automotive accessories, we offer a wide range of high-quality products designed to enhance your vehicle’s functionality, appearance, and safety.<br/>From powerful LED headlight bulbs to durable exterior and interior accessories, every NH ONE product reflects our commitment to quality, reliability, and customer satisfaction. We understand the evolving needs of modern drivers and deliver solutions that blend cutting-edge technology with practical design.<br/>With a presence across major online marketplaces like Amazon, Flipkart, and our own retail channels, NH ONE has become a go-to choice for car enthusiasts and daily drivers alike.</p><p><br/><strong>Why Choose NH ONE?</strong></p><p>🚗 <strong>Premium Quality Accessories</strong><br/><br/>💡 <strong>Innovative Lighting Solutions</strong><br/><br/>🛠️ <strong>Easy Installation & Compatibility</strong><br/><br/>🛒 <strong>Trusted by Thousands of Customers</strong><br/><br/>📦 <strong>Fast Delivery & Reliable Support</strong></p><p>Whether you're upgrading your ride for performance, visibility, or personal style — <strong>NH ONE powers every journey with confidence.</strong></p><p><strong>NH ONE – Drive with Purpose. Upgrade with Confidence.</strong></p>",
        "color_scheme": "scheme-1",
        "secondary_background": true
      }
